+// Q-Audion (P13): the max playback rate libopus is told to code up to. The SDP
+// value stays a hard ceiling (a remote that asked for narrowband must never
+// get more); the app can only lower it further, e.g. while the microphone is
+// a Bluetooth hands-free link that has no signal above 4 or 8 kHz. -1 from the
+// app means "no limit". Bitrate, ptime and CBR are not involved.
+int QaudionEffectiveMaxPlaybackRate(int sdp_max_playback_rate_hz) {
+  const int app_limit_hz = qaudion::OpusEncoderMaxPlaybackRate();
+  return app_limit_hz > 0 ? std::min(sdp_max_playback_rate_hz, app_limit_hz)
+                          : sdp_max_playback_rate_hz;
+}
+
+// Q-Audion (P13): what an encoded packet really used, from its TOC byte
+// (RFC 6716 section 3.1, config = toc >> 3). Small numbers only, so the line
+// survives the apps' log redactor: mode 0 SILK, 1 hybrid, 2 CELT; band
+// 0 narrowband, 1 mediumband, 2 wideband, 3 super-wideband, 4 fullband.
+int QaudionTocMode(uint8_t toc) {
+  const int config = toc >> 3;
+  return config < 12 ? 0 : (config < 16 ? 1 : 2);
+}
+
+int QaudionTocBand(uint8_t toc) {
+  const int config = toc >> 3;
+  if (config < 12) {
+    return config / 4;  // SILK-only: NB, MB, WB, four frame sizes each.
+  }
+  if (config < 16) {
+    return config < 14 ? 3 : 4;  // Hybrid: SWB, FB.
+  }
+  constexpr int kCeltBand[4] = {0, 2, 3, 4};  // CELT-only: NB, WB, SWB, FB.
+  return kCeltBand[(config - 16) / 4];
+}
