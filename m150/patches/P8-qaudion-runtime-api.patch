@@ -671,4 +671,63 @@ public class PeerConnectionFactory {
       long factory, MediaStreamTrack.MediaType mediaType);
   private static native RtpCapabilities nativeGetRtpReceiverCapabilities(
       long factory, MediaStreamTrack.MediaType mediaType);
+
+  // Q-Audion (M150 hardening, P8): process-wide runtime tuning. These apply to every live and
+  // future PeerConnection of this process; call them before creating a call's PeerConnection
+  // (and, for the two complexity setters, again mid-call if conditions change - e.g. a thermal
+  // throttling callback). None of them can fail: an out-of-range value is ignored and the
+  // previous value (or the build default) stays in effect.
+
+  /** Opus encoder complexity for every send stream, 0..10, or -1 for the build default. */
+  public static void setQaudionOpusEncoderComplexity(int complexity) {
+    nativeSetQaudionOpusEncoderComplexity(complexity);
+  }
+
+  /**
+   * Opus decoder complexity for every receive stream, 0..10, or -1 for the build default
+   * (kQaudionDefaultDecoderComplexity). Only 5 (deep PLC), 6 (OSCE LACE) and 7 (OSCE NoLACE)
+   * currently change behavior.
+   */
+  public static void setQaudionOpusDecoderComplexity(int complexity) {
+    nativeSetQaudionOpusDecoderComplexity(complexity);
+  }
+
+  /** Floor (0..20%) of the loss hint given to Opus, i.e. minimum in-band FEC. Build default 10. */
+  public static void setQaudionOpusMinPacketLossPercent(int percent) {
+    nativeSetQaudionOpusMinPacketLossPercent(percent);
+  }
+
+  /** From now on, reject DTLS handshakes that did not negotiate X25519MLKEM768. Tighten-only. */
+  public static void setQaudionRequireDtlsPqc() {
+    nativeSetQaudionRequireDtlsPqc();
+  }
+
+  /**
+   * Transport hardening level, 0..3 (switchable/LiveKit builds only; strict/plain builds are
+   * always at 3). Raise-only: a level lower than the current one is ignored.
+   */
+  public static void raiseQaudionTransportLevel(int level) {
+    nativeRaiseQaudionTransportLevel(level);
+  }
+
+  /**
+   * From now on, reject FrameCryptor's unauthenticated `uncrypted_magic_bytes` bypass (finding
+   * #13). Tighten-only; a no-op (always already disabled) on strict/plain builds.
+   */
+  public static void setQaudionDisableMagicBytesBypass() {
+    nativeSetQaudionDisableMagicBytesBypass();
+  }
+
+  /** Ids-only build description (no keys/secrets/hosts/user data) for telemetry. */
+  public static String getQaudionBuildInfo() {
+    return nativeGetQaudionBuildInfo();
+  }
+
+  private static native void nativeSetQaudionOpusEncoderComplexity(int complexity);
+  private static native void nativeSetQaudionOpusDecoderComplexity(int complexity);
+  private static native void nativeSetQaudionOpusMinPacketLossPercent(int percent);
+  private static native void nativeSetQaudionRequireDtlsPqc();
+  private static native void nativeRaiseQaudionTransportLevel(int level);
+  private static native void nativeSetQaudionDisableMagicBytesBypass();
