+// 64-bit `long` on arm64, so every value crossing into the 32-bit `int` the C++ API takes is
+// clamped here first (finding #14) - narrowing an out-of-range NSInteger without clamping would
+// truncate instead of falling into webrtc::qaudion's own range check. The -1 "build default"
+// sentinel is part of the encoder/decoder complexity setters' valid domain, so the clamp range
+// for those two is [-1, 10], not [0, 10].
+static int QaudionClampNSInteger(NSInteger value, NSInteger lo, NSInteger hi) {
+  if (value < lo) {
+    return static_cast<int>(lo);
+  }
+  if (value > hi) {
+    return static_cast<int>(hi);
+  }
+  return static_cast<int>(value);
+}
