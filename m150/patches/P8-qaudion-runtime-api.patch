diff --git a/rtc_base/qaudion_tuning.cc b/rtc_base/qaudion_tuning.cc
new file mode 100644
index 0000000..a36d41f
--- /dev/null
+++ b/rtc_base/qaudion_tuning.cc
@@ -0,0 +1,151 @@
+/*
+ *  Q-Audion runtime tuning API (M150 hardening, patch P8). See the header
+ *  for the contract; this file is the whole implementation.
+ */
+#include "rtc_base/qaudion_tuning.h"
+
+#include <atomic>
+#include <cstdint>
+#include <string>
+
+namespace webrtc::qaudion {
+
+namespace {
+
+// -1 = no override (encoder) / use kQaudionDefaultDecoderComplexity
+// (decoder). Deliberately not zero-initialized to a real complexity value,
+// so "nobody called the setter yet" is never confused with "the app asked
+// for complexity 0".
+std::atomic<int> g_enc_complexity{-1};
+std::atomic<int> g_dec_complexity{-1};
+std::atomic<int> g_min_loss_percent{10};
+std::atomic<int> g_transport_level{0};
+std::atomic<bool> g_require_pqc{false};
+std::atomic<bool> g_magic_bypass_disabled{false};
+std::atomic<uint32_t> g_generation{0};
+
+void Bump() {
+  g_generation.fetch_add(1, std::memory_order_release);
+}
+
+}  // namespace
+
+void SetOpusEncoderComplexity(int complexity) {
+  if (complexity < -1 || complexity > 10) {
+    return;
+  }
+  if (g_enc_complexity.exchange(complexity, std::memory_order_acq_rel) !=
+      complexity) {
+    Bump();
+  }
+}
+
+int OpusEncoderComplexity() {
+  return g_enc_complexity.load(std::memory_order_acquire);
+}
+
+void SetOpusDecoderComplexity(int complexity) {
+  if (complexity < -1 || complexity > 10) {
+    return;
+  }
+  if (g_dec_complexity.exchange(complexity, std::memory_order_acq_rel) !=
+      complexity) {
+    Bump();
+  }
+}
+
+int OpusDecoderComplexity() {
+  return g_dec_complexity.load(std::memory_order_acquire);
+}
+
+void SetOpusMinPacketLossPercent(int percent) {
+  if (percent < 0 || percent > 20) {
+    return;
+  }
+  if (g_min_loss_percent.exchange(percent, std::memory_order_acq_rel) !=
+      percent) {
+    Bump();
+  }
+}
+
+int OpusMinPacketLossPercent() {
+  return g_min_loss_percent.load(std::memory_order_acquire);
+}
+
+void SetRequireDtlsPqc() {
+  if (!g_require_pqc.exchange(true, std::memory_order_acq_rel)) {
+    Bump();
+  }
+}
+
+bool RequireDtlsPqc() {
+  return g_require_pqc.load(std::memory_order_acquire);
+}
+
+void RaiseTransportLevel(int level) {
+#if !QAUDION_TRANSPORT_STRICT
+  if (level < 0 || level > 3) {
+    return;
+  }
+  int current = g_transport_level.load(std::memory_order_acquire);
+  while (level > current) {
+    if (g_transport_level.compare_exchange_weak(
+            current, level, std::memory_order_acq_rel,
+            std::memory_order_acquire)) {
+      Bump();
+      return;
+    }
+    // compare_exchange_weak refreshed `current` on failure; loop re-checks
+    // `level > current` in case another thread already raised it past us.
+  }
+#else
+  // Strict (1:1) builds are always at the maximum level; nothing to raise.
+  (void)level;
+#endif
+}
+
+int TransportLevel() {
+#if QAUDION_TRANSPORT_STRICT
+  return 3;
+#else
+  return g_transport_level.load(std::memory_order_acquire);
+#endif
+}
+
+void DisableMagicBytesBypass() {
+  if (!g_magic_bypass_disabled.exchange(true, std::memory_order_acq_rel)) {
+    Bump();
+  }
+}
+
+bool MagicBytesBypassAllowed() {
+#if QAUDION_TRANSPORT_STRICT
+  return false;
+#else
+  return !g_magic_bypass_disabled.load(std::memory_order_acquire);
+#endif
+}
+
+uint32_t TuningGeneration() {
+  return g_generation.load(std::memory_order_acquire);
+}
+
+std::string BuildInfo() {
+  std::string info = "Q-AUDION build m150 transport=";
+#if QAUDION_TRANSPORT_STRICT
+  info += "strict";
+#else
+  info += "switchable";
+#endif
+  info += " level=" + std::to_string(TransportLevel());
+  info += " pqc_required=" + std::string(RequireDtlsPqc() ? "1" : "0");
+  info +=
+      " magic_bypass_disabled=" +
+      std::string(MagicBytesBypassAllowed() ? "0" : "1");
+  info += " enc_cx=" + std::to_string(OpusEncoderComplexity());
+  info += " dec_cx=" + std::to_string(OpusDecoderComplexity());
+  info += " min_loss_pct=" + std::to_string(OpusMinPacketLossPercent());
+  return info;
+}
+
+}  // namespace webrtc::qaudion
diff --git a/rtc_base/qaudion_tuning.h b/rtc_base/qaudion_tuning.h
new file mode 100644
index 0000000..04fd734
--- /dev/null
+++ b/rtc_base/qaudion_tuning.h
@@ -0,0 +1,118 @@
+/*
+ *  Q-Audion runtime tuning API (M150 hardening, patch P8).
+ *
+ *  Process-wide knobs the app can adjust per call, without a rebuild and
+ *  without registering any custom field trial. Every setter here validates
+ *  and (where the valid domain is a plain range) clamps its input before
+ *  storing it, so no value coming from the app - or from anything the app
+ *  itself derived from the network, such as a remote flag or an SDP
+ *  attribute - can reach an RTC_CHECK or an out-of-range libopus/BoringSSL
+ *  call. All state is a small set of std::atomic<> variables: every
+ *  function here is lock-free and safe to call from any thread, including
+ *  concurrently with itself.
+ *
+ *  QAUDION_TRANSPORT_STRICT (from webrtc.gni's rtc_qaudion_transport_strict,
+ *  wired into //:common_config - one of every rtc_library/rtc_source_set/
+ *  etc. target's own default configs, see BUILD.gn - so every translation
+ *  unit in the binary agrees on the same value) tells the "fixed" plain
+ *  builds (1:1 calls, org.webrtc / RTCPeerConnectionFactory) from the
+ *  "switchable" LiveKit-prefixed builds (group calls, an SFU in the
+ *  middle):
+ *    - QAUDION_TRANSPORT_STRICT=1 (plain): TransportLevel() is pinned to 3
+ *      and MagicBytesBypassAllowed() is pinned to false. RaiseTransportLevel
+ *      is a no-op. The app cannot loosen anything.
+ *    - QAUDION_TRANSPORT_STRICT=0 (LiveKit): everything starts at today's
+ *      upstream behavior (level 0, bypass allowed) and the app can only
+ *      tighten it at runtime via the setters below, for the life of the
+ *      process. There is no setter that lowers a level or re-enables the
+ *      bypass once disabled.
+ */
+#ifndef RTC_BASE_QAUDION_TUNING_H_
+#define RTC_BASE_QAUDION_TUNING_H_
+
+#if !defined(QAUDION_TRANSPORT_STRICT)
+#error \
+    "QAUDION_TRANSPORT_STRICT must come from //:common_inherited_config (see rtc_qaudion_transport_strict in webrtc.gni and BUILD.gn)"
+#endif
+
+#include <cstdint>
+#include <string>
+
+namespace webrtc::qaudion {
+
+// Effective decoder complexity used whenever the app has not called
+// SetOpusDecoderComplexity() (i.e. it is still -1). 7 is >= 5 (deep PLC,
+// opus_decoder.c) and >= 7 (OSCE NoLACE, when P4a compiles OSCE in); the
+// integrator may retune this constant from the OSCE quality measurement
+// mentioned in the M150 plan.
+inline constexpr int kQaudionDefaultDecoderComplexity = 7;
+
+// ---------------------------------------------------------------------------
+// Opus encoder complexity: per call, mid-call changes allowed.
+// -1 (the default) means "no override, use the caller's own bitrate-based
+// table"; 0..10 is a direct override. Any other value is ignored (the
+// previous value, valid or -1, is kept) - never RTC_CHECKed.
+void SetOpusEncoderComplexity(int complexity);
+int OpusEncoderComplexity();
+
+// ---------------------------------------------------------------------------
+// Opus decoder complexity (finding #15): per call, clamped 0..10; only 5, 6
+// and 7 currently change behavior at this Opus revision (deep PLC / OSCE
+// LACE / OSCE NoLACE - see opus_decoder.c's OPUS_SET_COMPLEXITY handling).
+// -1 (the default) means "use kQaudionDefaultDecoderComplexity". The value
+// is read and applied from the decode call path only (see P4b's
+// WebRtcOpus_Decode), so it is never applied concurrently with the
+// opus_decode() call it precedes for the same decoder instance.
+void SetOpusDecoderComplexity(int complexity);
+int OpusDecoderComplexity();
+
+// ---------------------------------------------------------------------------
+// FEC / packet-loss floor, percent, clamped 0..20. Default 10 (see finding
+// requiring FEC floor parity with the plan's D8/D9 decision). This is the
+// runtime equivalent of a WebRTC-Audio-OpusMinPacketLossRate trial value,
+// expressed as a plain setter so it can also change mid-call.
+void SetOpusMinPacketLossPercent(int percent);
+int OpusMinPacketLossPercent();
+
+// ---------------------------------------------------------------------------
+// Require the DTLS handshake to have negotiated the X25519MLKEM768 hybrid
+// group (checked by the crypto author's P7). Tighten-only for the life of
+// the process: there is no way to turn this back off short of restarting.
+void SetRequireDtlsPqc();
+bool RequireDtlsPqc();
+
+// ---------------------------------------------------------------------------
+// Transport hardening level, 0..3 (see the M150 plan's P7 table). Raise-only
+// and a no-op in QAUDION_TRANSPORT_STRICT builds, where TransportLevel()
+// always reads back 3 regardless of what is passed here. Used by the
+// LiveKit-prefixed ("switchable") variants only.
+void RaiseTransportLevel(int level);
+int TransportLevel();
+
+// ---------------------------------------------------------------------------
+// Finding #13: FrameCryptor's `uncrypted_magic_bytes` bypass lets a frame
+// that merely *ends* with a configured magic value through unauthenticated,
+// which would let an SFU inject media. Once DisableMagicBytesBypass() is
+// called, MagicBytesBypassAllowed() stays false for the life of the process
+// (tighten-only). In QAUDION_TRANSPORT_STRICT builds the bypass is always
+// reported not-allowed, independent of whether this setter was ever called.
+void DisableMagicBytesBypass();
+bool MagicBytesBypassAllowed();
+
+// ---------------------------------------------------------------------------
+// Bumped once for every setter call above that actually changed a stored
+// value (a call that is out of range, or that repeats the current value, or
+// that tries to loosen a tighten-only knob, does not bump it). Consumers
+// that must react to a change - the Opus encoder/decoder complexity and FEC
+// floor - poll this once per call/frame instead of taking a lock or being
+// pushed a callback.
+uint32_t TuningGeneration();
+
+// Ids and small integers only - never a key, secret, salt, password, host,
+// IP or any call/device/user identifier (see the M150 hard rule on the
+// public repo and on RTC_LOG of key material). Safe to log or place in
+// telemetry as-is.
+std::string BuildInfo();
+
+}  // namespace webrtc::qaudion
+
+#endif  // RTC_BASE_QAUDION_TUNING_H_
