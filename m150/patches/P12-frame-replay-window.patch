+TEST(FrameReplayWindow, GcOnKeyMaterialChange) {
+  HandlerFixture f;
+  f.handler->SetKey(TestKey32(1), 0);
+  f.handler->SetKey(TestKey32(2), 1);
+  ASSERT_EQ(f.handler->ReplayCheck(7, 5, 0, true), ReplayVerdict::kOk);
+  ASSERT_EQ(f.handler->ReplayCheck(8, 5, 1, true), ReplayVerdict::kOk);
+  ASSERT_EQ(f.handler->ReplayWindowCountForTesting(), 2u);
+
+  // A different key in slot 3: no window used slot 3, nothing is collected.
+  f.handler->SetKey(TestKey32(3), 3);
+  EXPECT_EQ(f.handler->ReplayWindowCountForTesting(), 2u);
+  EXPECT_EQ(f.handler->ReplayCheck(7, 5, 0, true), ReplayVerdict::kDuplicate);
+
+  // Overwriting slot 0 with different material collects the window that only
+  // slot 0 ever authenticated; the other one survives.
+  f.handler->SetKey(TestKey32(9), 0);
+  EXPECT_EQ(f.handler->ReplayWindowCountForTesting(), 1u);
+  EXPECT_EQ(f.handler->ReplayCheck(8, 5, 1, true), ReplayVerdict::kDuplicate);
+  // The collected stream opens a fresh window under the new key.
+  EXPECT_EQ(f.handler->ReplayCheck(7, 5, 0, true), ReplayVerdict::kOk);
+  EXPECT_EQ(f.handler->ReplayWindowCountForTesting(), 2u);
+
+  // A zeroed retirement counts as a different key too.
+  f.handler->SetKey(std::vector<uint8_t>(32, 0), 1);
+  EXPECT_EQ(f.handler->ReplayWindowCountForTesting(), 1u);
+}
