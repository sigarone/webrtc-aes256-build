+TEST(FrameCryptorReplay, ForgedFramesNeitherAdvanceNorCreateAWindow) {
+  ReplayTestThread signaling;
+  auto tx_provider = MakeHkdfProvider(false);
+  auto rx_provider = MakeHkdfProvider(false);
+  ASSERT_TRUE(tx_provider->SetKey("ivy", 0, TestKey32(1)));
+  ASSERT_TRUE(rx_provider->SetKey("ivy", 0, TestKey32(1)));
+  Cryptor tx(signaling.get(), "ivy", CryptorMediaType::kAudioFrame, tx_provider, 0);
+  Cryptor rx(signaling.get(), "ivy", CryptorMediaType::kAudioFrame, rx_provider, 0);
+  const uint32_t ssrc = 0x21436587u;
+  const auto p0 = AudioPayload(30, 1);
+  const auto p1 = AudioPayload(30, 2);
+  const auto w0 = SealAudio(tx, p0, ssrc, 1000);
+  const auto w1 = SealAudio(tx, p1, ssrc, 1960);
+
+  // Forged first: tampered ciphertext on a never-seen ssrc. The tag fails, so
+  // no window may be created.
+  std::vector<uint8_t> tampered = w0;
+  tampered[3] ^= 0x40;
+  FeedAudio(rx, tampered, ssrc, 1000, FrameDirection::kReceiver);
+  ASSERT_TRUE(rx.observer->WaitFor(FrameCryptionState::kDecryptionFailed));
+  EXPECT_EQ(rx_provider->GetKey("ivy")->ReplayWindowCountForTesting(), 0u);
+
+  FeedAudio(rx, w0, ssrc, 1000, FrameDirection::kReceiver);
+  ASSERT_TRUE(rx.sink->WaitForCount(1));
+  EXPECT_EQ(rx_provider->GetKey("ivy")->ReplayWindowCountForTesting(), 1u);
+
+  // Forged IV: counter pushed to 2^31. The IV is the GCM nonce, so the tag
+  // fails and the window top must NOT move.
+  std::vector<uint8_t> forged = w1;
+  const size_t w2_off = forged.size() - 14 + 4;
+  forged[w2_off] ^= 0x80;  // word 2 += 2^31, word 3 unchanged
+  FeedAudio(rx, forged, ssrc, 1960, FrameDirection::kReceiver);
+  FeedAudio(rx, w1, ssrc, 1960, FrameDirection::kReceiver);  // genuine counter 1
+  ASSERT_TRUE(rx.sink->WaitForCount(2));
+  signaling.Flush();
+  EXPECT_EQ(rx.sink->Frame(1), p1);
+  EXPECT_EQ(rx_provider->GetKey("ivy")->GetReplayCounters().old, 0u);
+}
