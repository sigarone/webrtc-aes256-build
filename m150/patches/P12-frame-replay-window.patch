+TEST(FrameCryptorReplay, CounterExhaustionDropsTheFrameAndReportsOnce) {
+  ReplayTestThread signaling;
+  auto tx_provider = MakeHkdfProvider(false);
+  auto rx_provider = MakeHkdfProvider(false);
+  ASSERT_TRUE(tx_provider->SetKey("kim", 0, TestKey32(1)));
+  ASSERT_TRUE(rx_provider->SetKey("kim", 0, TestKey32(1)));
+  Cryptor tx(signaling.get(), "kim", CryptorMediaType::kAudioFrame, tx_provider, 0);
+  Cryptor rx(signaling.get(), "kim", CryptorMediaType::kAudioFrame, rx_provider, 0);
+  const uint32_t ssrc = 0x5A5A5A5Au;
+  tx_provider->GetKey("kim")->SetSendCounterForTesting(ssrc, 0xFFFFFFFEu);
+
+  const auto pa = AudioPayload(20, 1);
+  const auto pb = AudioPayload(20, 2);
+  const auto wa = SealAudio(tx, pa, ssrc, 100);  // counter 0xFFFFFFFE
+  const auto wb = SealAudio(tx, pb, ssrc, 200);  // counter 0xFFFFFFFF
+  EXPECT_EQ(Be32(IvOf(wa), 4) - Be32(IvOf(wa), 8), 0xFFFFFFFEu);
+  EXPECT_EQ(Be32(IvOf(wb), 4) - Be32(IvOf(wb), 8), 0xFFFFFFFFu);
+
+  // Exhausted: dropped, nothing reaches the sink, kEncryptionFailed once.
+  FeedAudio(tx, AudioPayload(20, 3), ssrc, 300, FrameDirection::kSender);
+  FeedAudio(tx, AudioPayload(20, 4), ssrc, 400, FrameDirection::kSender);
+  ASSERT_TRUE(tx.observer->WaitFor(FrameCryptionState::kEncryptionFailed));
+  signaling.Flush();
+  EXPECT_EQ(tx.sink->Count(), 2u);
+  EXPECT_EQ(tx.observer->CountOf(FrameCryptionState::kEncryptionFailed), 1u);
+  EXPECT_GE(tx_provider->GetKey("kim")->GetReplayCounters().exhausted, 1u);
+
+  // The last two counters are valid on the receiver (window top = 2^32 - 1).
+  FeedAudio(rx, wa, ssrc, 100, FrameDirection::kReceiver);
+  FeedAudio(rx, wb, ssrc, 200, FrameDirection::kReceiver);
+  FeedAudio(rx, wb, ssrc, 200, FrameDirection::kReceiver);
+  FeedAudio(rx, wa, ssrc, 100, FrameDirection::kReceiver);
+  // A frame of another ssrc (own counter 0) closes the sequence.
+  const auto ps = AudioPayload(20, 5);
+  const auto ws = SealAudio(tx, ps, ssrc + 1, 500);
+  FeedAudio(rx, ws, ssrc + 1, 500, FrameDirection::kReceiver);
+  ASSERT_TRUE(rx.sink->WaitForCount(3));
+  signaling.Flush();
+  EXPECT_EQ(rx.sink->Count(), 3u);
+  EXPECT_EQ(rx.sink->Frame(0), pa);
+  EXPECT_EQ(rx.sink->Frame(1), pb);
+  EXPECT_EQ(rx.sink->Frame(2), ps);
+}
