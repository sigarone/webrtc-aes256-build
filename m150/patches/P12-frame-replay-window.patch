+uint32_t Be32(const std::vector<uint8_t>& v, size_t offset) {
+  return (static_cast<uint32_t>(v[offset]) << 24) |
+         (static_cast<uint32_t>(v[offset + 1]) << 16) |
+         (static_cast<uint32_t>(v[offset + 2]) << 8) |
+         static_cast<uint32_t>(v[offset + 3]);
+}
+
+// The 12-byte IV of a NON-escaped frame (audio / VP8): ... iv(12) trailer(2).
+std::vector<uint8_t> IvOf(const std::vector<uint8_t>& wire) {
+  return std::vector<uint8_t>(wire.end() - 14, wire.end() - 2);
+}
+
+class CollectingSink : public TransformedFrameCallback {
+ public:
+  void OnTransformedFrame(
+      std::unique_ptr<TransformableFrameInterface> frame) override {
+    std::span<const uint8_t> data = frame->GetData();
+    std::lock_guard<std::mutex> lock(mutex_);
+    frames_.emplace_back(data.begin(), data.end());
+    cv_.notify_all();
+  }
+  bool WaitForCount(size_t count, int timeout_ms = 15000) {
+    std::unique_lock<std::mutex> lock(mutex_);
+    return cv_.wait_for(lock, std::chrono::milliseconds(timeout_ms),
+                        [&] { return frames_.size() >= count; });
+  }
+  size_t Count() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return frames_.size();
+  }
+  std::vector<uint8_t> Frame(size_t index) const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return index < frames_.size() ? frames_[index] : std::vector<uint8_t>();
+  }
+
+ private:
+  mutable std::mutex mutex_;
+  std::condition_variable cv_;
+  std::vector<std::vector<uint8_t>> frames_;
+};
+
+class CollectingObserver : public FrameCryptorTransformerObserver {
+ public:
+  void OnFrameCryptionStateChanged(const std::string participant_id,
+                                   FrameCryptionState state) override {
+    std::lock_guard<std::mutex> lock(mutex_);
+    states_.push_back(state);
+    cv_.notify_all();
+  }
+  bool WaitFor(FrameCryptionState state, int timeout_ms = 10000) {
+    std::unique_lock<std::mutex> lock(mutex_);
+    return cv_.wait_for(lock, std::chrono::milliseconds(timeout_ms), [&] {
+      return std::count(states_.begin(), states_.end(), state) > 0;
+    });
+  }
+  size_t CountOf(FrameCryptionState state) const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return static_cast<size_t>(
+        std::count(states_.begin(), states_.end(), state));
+  }
+
+ private:
+  mutable std::mutex mutex_;
+  std::condition_variable cv_;
+  std::vector<FrameCryptionState> states_;
+};
