+TEST(FrameCryptorKat, VectorFileIsComplete) {
+  EXPECT_EQ(std::size(kKatCases), kKatExpectedCases);
+  EXPECT_EQ(std::size(kKatCounterCases), kKatExpectedCounterCases);
+  EXPECT_EQ(std::size(kKatReplayFrames), kKatExpectedReplayFrames);
+  EXPECT_EQ(std::size(kKatScenarios), kKatExpectedScenarios);
+  EXPECT_EQ(std::size(kKatRingScenarios), kKatExpectedRingScenarios);
+}
+
+TEST(FrameCryptorKat, EveryCaseOpensToThePlaintext) {
+  ReplayTestThread signaling;
+  for (const KatFrame& f : kKatCases) {
+    std::vector<uint8_t> plain;
+    ASSERT_TRUE(KatOpen(signaling.get(), f, FromHex(f.wire_hex), &plain)) << f.id;
+    EXPECT_EQ(plain, FromHex(f.plaintext_hex)) << f.id;
+  }
+}
+
+TEST(FrameCryptorKat, EveryCaseResealsByteForByte) {
+  ReplayTestThread signaling;
+  for (const KatFrame& f : kKatCases) {
+    std::vector<uint8_t> wire;
+    ASSERT_TRUE(KatSeal(signaling.get(), f, &wire)) << f.id;
+    EXPECT_EQ(wire, FromHex(f.wire_hex)) << f.id;
+  }
+}
+
+TEST(FrameCryptorKat, CounterCasesOpenAndResealByteForByte) {
+  ReplayTestThread signaling;
+  for (const KatFrame& f : kKatCounterCases) {
+    std::vector<uint8_t> plain;
+    ASSERT_TRUE(KatOpen(signaling.get(), f, FromHex(f.wire_hex), &plain)) << f.id;
+    EXPECT_EQ(plain, FromHex(f.plaintext_hex)) << f.id;
+
+    std::vector<uint8_t> wire;
+    ASSERT_TRUE(KatSeal(signaling.get(), f, &wire)) << f.id;
+    EXPECT_EQ(wire, FromHex(f.wire_hex)) << f.id;
+
+    if (f.codec == kKatH264 && std::strlen(f.wire_unescaped_hex) > 0) {
+      // The escaped wire differs from the unescaped body (the IV holds 00 00 01
+      // and must be unescaped before it is read) and unescapes to it exactly.
+      EXPECT_NE(FromHex(f.wire_hex), FromHex(f.wire_unescaped_hex)) << f.id;
+      EXPECT_EQ(KatUnescape(FromHex(f.wire_hex), 6), FromHex(f.wire_unescaped_hex))
+          << f.id;
+    }
+  }
+}
+
+TEST(FrameCryptorKat, RingScenarios) {
+  ReplayTestThread signaling;
+  std::vector<std::pair<int, std::string>> installed;
+  int current = -1;
+  for (const KatRingStep& s : kKatRingSteps) {
+    if (s.scenario != current) {
+      current = s.scenario;
+      installed.clear();
+    }
+    const KatScenario& sc = kKatRingScenarios[s.scenario];
+    if (s.kind == 0) {
+      installed.emplace_back(s.key_index, s.key_hex);
+      continue;
+    }
+    // Every ring frame has counter 0 on the same ssrc: each one is opened on a
+    // fresh provider that holds the keys installed so far (see casesNote).
+    auto provider = MakeHkdfProvider(false);
+    provider->SetKey(sc.participant, 0, std::vector<uint8_t>());  // empty handler
+    for (const auto& k : installed) {
+      provider->SetKey(sc.participant, k.first, FromHex(k.second.c_str()));
+    }
+    const KatFrame& f = kKatCases[s.frame];
+    std::vector<uint8_t> plain;
+    std::string problem;
+    const std::string verdict = KatClassify(signaling, provider, sc.participant, f,
+                                            FromHex(f.wire_hex), &plain, &problem);
+    EXPECT_EQ(problem, "") << sc.name << " " << f.id;
+    if (s.kind == 1) {
+      EXPECT_EQ(verdict, "ok") << sc.name << " " << f.id;
+      EXPECT_EQ(plain, FromHex(f.plaintext_hex)) << sc.name << " " << f.id;
+    } else {
+      EXPECT_EQ(verdict, s.reason) << sc.name << " " << f.id;
+    }
+  }
+}
+
+TEST(FrameCryptorKat, ReplayScenarios) {
+  ReplayTestThread signaling;
+  for (size_t si = 0; si < std::size(kKatScenarios); ++si) {
+    const KatScenario& sc = kKatScenarios[si];
+    auto provider = MakeHkdfProvider(false);
+    // Create the participant's handler up front (an empty ring: slot refused),
+    // then register the scenario's local send ssrcs on it (reflection guard).
+    provider->SetKey(sc.participant, 0, std::vector<uint8_t>());
+    auto handler = provider->GetKey(sc.participant);
+    ASSERT_NE(handler, nullptr) << sc.name;
+    for (int i = 0; i < sc.local_ssrc_count; ++i) {
+      ASSERT_TRUE(handler->NextSendCounter(sc.local_ssrcs[i]).has_value());
+    }
+    size_t delivered = 0;
+    for (const KatStep& st : kKatSteps) {
+      if (st.scenario != static_cast<int>(si)) continue;
+      if (st.deliver[0] == '\0') {
+        provider->SetKey(st.participant, st.key_index, FromHex(st.key_hex));
+        continue;
+      }
+      const KatFrame* f = KatFind(kKatReplayFrames, std::size(kKatReplayFrames),
+                                  st.deliver);
+      ASSERT_NE(f, nullptr) << sc.name << " " << st.deliver;
+      std::vector<uint8_t> plain;
+      std::string problem;
+      const std::string verdict = KatClassify(signaling, provider, st.participant,
+                                              *f, FromHex(f->wire_hex), &plain,
+                                              &problem);
+      ++delivered;
+      EXPECT_EQ(problem, "") << sc.name << " step " << delivered << " " << st.deliver;
+      EXPECT_EQ(verdict, st.expect) << sc.name << " step " << delivered << " "
+                                    << st.deliver;
+      if (verdict == "ok") {
+        EXPECT_EQ(plain, FromHex(f->plaintext_hex)) << sc.name << " " << st.deliver;
+      }
+    }
+    EXPECT_GT(delivered, 0u) << sc.name;
+  }
+}
