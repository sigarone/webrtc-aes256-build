+// 32-byte AES-256 key material. P1 refuses anything shorter.
+std::vector<uint8_t> TestKey32(uint8_t seed = 0) {
+  std::vector<uint8_t> key(32);
+  for (size_t i = 0; i < key.size(); ++i) {
