+  ReplayTestThread() : thread_(Thread::Create()) {
+    thread_->SetName("replay-signaling", nullptr);
+    thread_->Start();
+  }
+  ~ReplayTestThread() { thread_->Stop(); }
+  Thread* get() { return thread_.get(); }
+  // Everything posted before this call has run when it returns.
+  void Flush() {
+    std::promise<void> done;
+    std::future<void> future = done.get_future();
+    thread_->PostTask([&done] { done.set_value(); });
+    future.wait_for(std::chrono::seconds(10));
+  }
+
+ private:
+  std::unique_ptr<Thread> thread_;
+};
