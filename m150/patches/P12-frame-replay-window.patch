+// Q-Audion P12 (D7, design section 3.6): at most one line per 10 s per transformer, only
+// when a drop counter moved. No ssrc, participant id, key index, key or IV.
+// The literal "Q-AUDION frame-replay" is the build marker gates.sh (G3)
+// checks for.
+void FrameCryptorTransformer::maybeLogReplayDrops(
+    ParticipantKeyHandler* key_handler) {
+  constexpr int64_t kReplayLogMinIntervalMs = 10000;
+  const int64_t now_ms = webrtc::TimeMillis();
+  if (replay_log_started_ &&
+      now_ms - last_replay_log_ms_ < kReplayLogMinIntervalMs) {
+    return;
+  }
+  const ReplayCounters cur = key_handler->GetReplayCounters();
+  const uint64_t dup = cur.dup - last_replay_logged_.dup;
+  const uint64_t old = cur.old - last_replay_logged_.old;
+  const uint64_t refl = cur.refl - last_replay_logged_.refl;
+  const uint64_t cap = cur.cap - last_replay_logged_.cap;
+  if (dup + old + refl + cap == 0) {
+    return;
+  }
+  replay_log_started_ = true;
+  last_replay_log_ms_ = now_ms;
+  last_replay_logged_ = cur;
+  RTC_LOG(LS_WARNING) << "Q-AUDION frame-replay drop dup=" << dup
+                      << " old=" << old << " refl=" << refl << " cap=" << cap
+                      << " kind="
+                      << (type_ == MediaType::kAudioFrame ? "audio" : "video");
+}
