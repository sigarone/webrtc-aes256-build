+TEST(FrameReplayWindow, ShiftOf255KeepsTheOldTop) {
+  HandlerFixture f;
+  ASSERT_EQ(f.handler->ReplayCheck(7, 0, 0, true), ReplayVerdict::kOk);
+  ASSERT_EQ(f.handler->ReplayCheck(7, 255, 0, true), ReplayVerdict::kOk);
+  // Counter 0 is exactly 255 behind the new top: inside the window, seen.
+  EXPECT_EQ(f.handler->ReplayCheck(7, 0, 0, true), ReplayVerdict::kDuplicate);
+  EXPECT_EQ(f.handler->ReplayCheck(7, 1, 0, true), ReplayVerdict::kOk);
+  ASSERT_EQ(f.handler->ReplayCheck(7, 256, 0, true), ReplayVerdict::kOk);
+  // Now counter 0 is 256 behind: out.
+  EXPECT_EQ(f.handler->ReplayCheck(7, 0, 0, true), ReplayVerdict::kTooOld);
+}
