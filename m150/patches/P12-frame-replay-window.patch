+TEST(FrameCryptorReplay, Vp8KeyAndDeltaFramesRoundTrip) {
+  ReplayTestThread signaling;
+  auto tx_provider = MakeHkdfProvider(false);
+  auto rx_provider = MakeHkdfProvider(false);
+  ASSERT_TRUE(tx_provider->SetKey("bob", 1, TestKey32(5)));
+  ASSERT_TRUE(rx_provider->SetKey("bob", 1, TestKey32(5)));
+  const uint32_t ssrc = 0x01020304u;
+  Cryptor tx(signaling.get(), "bob", CryptorMediaType::kVideoFrame, tx_provider, 1,
+             ssrc);
+  Cryptor rx(signaling.get(), "bob", CryptorMediaType::kVideoFrame, rx_provider, 1,
+             ssrc);
+  for (int i = 0; i < 4; ++i) {
+    const bool key_frame = (i % 2) == 0;
+    const size_t clear = key_frame ? 10 : 3;
+    std::vector<uint8_t> plain = AudioPayload(120, static_cast<uint8_t>(i + 9));
+    const uint32_t ts = 90000 * (i + 1);
+    tx.Feed(std::make_unique<TestVideoFrame>(plain, ssrc, ts, FrameDirection::kSender,
+                                             VideoCodecType::kVideoCodecVP8,
+                                             key_frame));
+    ASSERT_TRUE(tx.sink->WaitForCount(i + 1));
+    const std::vector<uint8_t> wire = tx.sink->Frame(i);
+    ASSERT_EQ(wire.size(), plain.size() + 16 + 12 + 2);
+    EXPECT_TRUE(std::equal(plain.begin(), plain.begin() + clear, wire.begin()));
+    EXPECT_EQ(Be32(IvOf(wire), 8), ts - static_cast<uint32_t>(i));
+
+    rx.Feed(std::make_unique<TestVideoFrame>(wire, ssrc, ts, FrameDirection::kReceiver,
+                                             VideoCodecType::kVideoCodecVP8,
+                                             key_frame));
+    ASSERT_TRUE(rx.sink->WaitForCount(i + 1));
+    EXPECT_EQ(rx.sink->Frame(i), plain);
+  }
