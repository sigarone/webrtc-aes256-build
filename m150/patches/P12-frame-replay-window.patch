+  FeedAudio(rx, peer_wire, peer_ssrc, 700, FrameDirection::kReceiver);
+  ASSERT_TRUE(rx.sink->WaitForCount(1));
+  signaling.Flush();
+  EXPECT_EQ(rx.sink->Count(), 1u);
+  EXPECT_EQ(rx.sink->Frame(0), peer_plain);
+  EXPECT_EQ(local->GetSharedKey("peer")->GetReplayCounters().refl, 1u);
+  EXPECT_EQ(rx.observer->CountOf(FrameCryptionState::kDecryptionFailed), 0u);
+  EXPECT_EQ(rx.observer->CountOf(FrameCryptionState::kMissingKey), 0u);
