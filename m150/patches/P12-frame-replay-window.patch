+TEST(FrameCryptorReplay, AudioRoundTripAndIvLayout) {
+  ReplayTestThread signaling;
+  auto tx_provider = MakeHkdfProvider(false);
+  auto rx_provider = MakeHkdfProvider(false);
+  ASSERT_TRUE(tx_provider->SetKey("alice", 3, TestKey32(1)));
+  ASSERT_TRUE(rx_provider->SetKey("alice", 3, TestKey32(1)));
+  Cryptor tx(signaling.get(), "alice", CryptorMediaType::kAudioFrame, tx_provider, 3);
+  Cryptor rx(signaling.get(), "alice", CryptorMediaType::kAudioFrame, rx_provider, 3);
+
+  const uint32_t ssrc = 0x11223344u;
+  const uint32_t ts0 = 4294967000u;  // the RTP timestamp wraps at i = 1
+  for (uint32_t i = 0; i < 4; ++i) {
+    const std::vector<uint8_t> plain = AudioPayload(40, static_cast<uint8_t>(i));
+    const uint32_t ts = ts0 + 960 * i;
+    const std::vector<uint8_t> wire = SealAudio(tx, plain, ssrc, ts);
+    ASSERT_EQ(wire.size(), plain.size() + 16 + 12 + 2);
+    EXPECT_EQ(wire[0], plain[0]);  // 1 clear header byte for Opus
+    EXPECT_EQ(wire[wire.size() - 2], 12);
+    EXPECT_EQ(wire[wire.size() - 1], 3);
+    const std::vector<uint8_t> iv = IvOf(wire);
+    EXPECT_EQ(Be32(iv, 0), ssrc);
+    EXPECT_EQ(Be32(iv, 4), ts);
+    EXPECT_EQ(Be32(iv, 8), ts - i);  // counter = i, full width, mod 2^32
+
+    FeedAudio(rx, wire, ssrc, ts, FrameDirection::kReceiver);
+    ASSERT_TRUE(rx.sink->WaitForCount(i + 1));
+    EXPECT_EQ(rx.sink->Frame(i), plain);
+  }
+  signaling.Flush();
+  EXPECT_EQ(rx.observer->CountOf(FrameCryptionState::kDecryptionFailed), 0u);
+  EXPECT_EQ(rx.observer->CountOf(FrameCryptionState::kMissingKey), 0u);
+}
