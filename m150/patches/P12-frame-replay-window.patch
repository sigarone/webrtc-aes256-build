+TEST(FrameReplayWindow, CapRejectsTheSixtyFifthStreamAndNeverEvicts) {
+  HandlerFixture f;
+  for (uint32_t ssrc = 1; ssrc <= kMaxReplayWindowsPerHandler; ++ssrc) {
+    ASSERT_EQ(f.handler->ReplayCheck(ssrc, 0, 0, true), ReplayVerdict::kOk)
+        << ssrc;
+  }
+  EXPECT_EQ(f.handler->ReplayWindowCountForTesting(),
+            kMaxReplayWindowsPerHandler);
+  const uint32_t extra = 1000;
+  // The pre-check cannot know the window would be refused: it changes nothing
+  // and says kOk. The authoritative commit says kCap.
+  EXPECT_EQ(f.handler->ReplayCheck(extra, 0, 0, false), ReplayVerdict::kOk);
+  EXPECT_EQ(f.handler->ReplayCheck(extra, 0, 0, true), ReplayVerdict::kCap);
+  EXPECT_EQ(f.handler->ReplayCheck(extra, 1, 0, true), ReplayVerdict::kCap);
+  EXPECT_EQ(f.handler->GetReplayCounters().cap, 2u);
+  EXPECT_EQ(f.handler->ReplayWindowCountForTesting(),
+            kMaxReplayWindowsPerHandler);
+  // Existing windows keep working and still reject duplicates (no eviction).
+  EXPECT_EQ(f.handler->ReplayCheck(1, 0, 0, true), ReplayVerdict::kDuplicate);
+  EXPECT_EQ(f.handler->ReplayCheck(1, 1, 0, true), ReplayVerdict::kOk);
+  EXPECT_EQ(f.handler->ReplayCheck(64, 0, 0, true), ReplayVerdict::kDuplicate);
+}
