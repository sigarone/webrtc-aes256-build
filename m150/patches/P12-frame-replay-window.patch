+TEST(FrameReplayWindow, ShiftOf256OrMoreResetsTheWindow) {
+  HandlerFixture f;
+  ASSERT_EQ(f.handler->ReplayCheck(7, 10, 0, true), ReplayVerdict::kOk);
+  // Jump by exactly 256: the old top falls out, only the new top is set.
+  ASSERT_EQ(f.handler->ReplayCheck(7, 266, 0, true), ReplayVerdict::kOk);
+  EXPECT_EQ(f.handler->ReplayCheck(7, 10, 0, true), ReplayVerdict::kTooOld);
+  EXPECT_EQ(f.handler->ReplayCheck(7, 266, 0, true), ReplayVerdict::kDuplicate);
+  // 255 behind the new top was never seen.
+  EXPECT_EQ(f.handler->ReplayCheck(7, 11, 0, true), ReplayVerdict::kOk);
+  EXPECT_EQ(f.handler->ReplayCheck(7, 11, 0, true), ReplayVerdict::kDuplicate);
+  // A jump far beyond the window.
+  ASSERT_EQ(f.handler->ReplayCheck(7, 1000000, 0, true), ReplayVerdict::kOk);
+  EXPECT_EQ(f.handler->ReplayCheck(7, 266, 0, true), ReplayVerdict::kTooOld);
+}
