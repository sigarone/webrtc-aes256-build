+
+// Annex-B H.264 IDR slice: start code, NAL header, 1 byte, then payload that
+// contains no start code.
+std::vector<uint8_t> H264Idr(size_t payload_len, uint8_t seed) {
+  std::vector<uint8_t> v = {0x00, 0x00, 0x00, 0x01, 0x65, 0x88};
+  for (size_t i = 0; i < payload_len; ++i) {
+    v.push_back(static_cast<uint8_t>(0x10 + ((seed + i * 5) % 0xE0)));
+  }
+  return v;
+}
+
+bool ContainsEmulationPrevention(const std::vector<uint8_t>& v, size_t from) {
+  for (size_t i = from; i + 2 < v.size(); ++i) {
+    if (v[i] == 0 && v[i + 1] == 0 && v[i + 2] == 3) {
+      return true;
+    }
+  }
+  return false;
+}
