+// D10 regression: the sender RBSP-escapes ciphertext||tag||iv||trailer as one
+// unit. An IV holding 00 00 0x (here ssrc 1 -> 00 00 00 01, timestamp
+// 0x100 -> 00 00 01 00) gets emulation-prevention bytes inserted INSIDE it, so
+// a receiver that reads the IV before unescaping reads a shifted IV and the
+// frame never decrypts.
+TEST(FrameCryptorReplay, H264FrameWhoseIvNeedsEscapingDecrypts) {
+  ReplayTestThread signaling;
+  auto tx_provider = MakeHkdfProvider(false);
+  auto rx_provider = MakeHkdfProvider(false);
+  ASSERT_TRUE(tx_provider->SetKey("carol", 2, TestKey32(7)));
+  ASSERT_TRUE(rx_provider->SetKey("carol", 2, TestKey32(7)));
+  const uint32_t ssrc = 0x00000001u;
+  Cryptor tx(signaling.get(), "carol", CryptorMediaType::kVideoFrame, tx_provider, 2,
+             ssrc);
+  Cryptor rx(signaling.get(), "carol", CryptorMediaType::kVideoFrame, rx_provider, 2,
+             ssrc);
+  for (int i = 0; i < 3; ++i) {
+    const std::vector<uint8_t> plain = H264Idr(100, static_cast<uint8_t>(i));
+    const uint32_t ts = 0x00000100u + i;  // 00 00 01 00 / 00 00 01 01 ...
+    tx.Feed(std::make_unique<TestVideoFrame>(plain, ssrc, ts, FrameDirection::kSender,
+                                             VideoCodecType::kVideoCodecH264,
+                                             true));
+    ASSERT_TRUE(tx.sink->WaitForCount(i + 1));
+    const std::vector<uint8_t> wire = tx.sink->Frame(i);
+    // Header = start code (4) + 2 bytes; the escaped tail is longer than the
+    // raw ciphertext||tag||iv||trailer and holds emulation-prevention bytes.
+    EXPECT_GT(wire.size(), plain.size() + 16 + 12 + 2);
+    EXPECT_TRUE(ContainsEmulationPrevention(wire, 6));
+
+    rx.Feed(std::make_unique<TestVideoFrame>(wire, ssrc, ts, FrameDirection::kReceiver,
+                                             VideoCodecType::kVideoCodecH264,
+                                             true));
+    ASSERT_TRUE(rx.sink->WaitForCount(i + 1)) << "frame " << i;
+    EXPECT_EQ(rx.sink->Frame(i), plain);
+  }
+  signaling.Flush();
+  EXPECT_EQ(rx.observer->CountOf(FrameCryptionState::kDecryptionFailed), 0u);
+}
