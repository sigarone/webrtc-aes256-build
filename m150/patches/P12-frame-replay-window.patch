+TEST(FrameCryptorReplay, KeySwitchKeepsTheWindowAndLateOldSlotFramesAreAccepted) {
+  ReplayTestThread signaling;
+  auto tx_provider = MakeHkdfProvider(false);
+  auto rx_provider = MakeHkdfProvider(false);
+  ASSERT_TRUE(tx_provider->SetKey("lee", 1, TestKey32(10)));
+  ASSERT_TRUE(tx_provider->SetKey("lee", 2, TestKey32(20)));
+  ASSERT_TRUE(rx_provider->SetKey("lee", 1, TestKey32(10)));
+  ASSERT_TRUE(rx_provider->SetKey("lee", 2, TestKey32(20)));
+  Cryptor tx(signaling.get(), "lee", CryptorMediaType::kAudioFrame, tx_provider, 1);
+  Cryptor rx(signaling.get(), "lee", CryptorMediaType::kAudioFrame, rx_provider, 1);
+  const uint32_t ssrc = 0x0BADF00Du;
+  std::vector<std::vector<uint8_t>> plains;
+  std::vector<std::vector<uint8_t>> wires;
+  for (uint32_t i = 0; i < 2; ++i) {
+    plains.push_back(AudioPayload(24, static_cast<uint8_t>(i)));
+    wires.push_back(SealAudio(tx, plains.back(), ssrc, 100 + 960 * i));
+  }
+  tx.transformer->SetKeyIndex(2);  // sender moves to the next slot
+  for (uint32_t i = 2; i < 4; ++i) {
+    plains.push_back(AudioPayload(24, static_cast<uint8_t>(i)));
+    wires.push_back(SealAudio(tx, plains.back(), ssrc, 100 + 960 * i));
+  }
+  // Counters keep increasing across the key switch.
+  EXPECT_EQ(wires[2][wires[2].size() - 1], 2);
+  EXPECT_EQ(Be32(IvOf(wires[2]), 4) - Be32(IvOf(wires[2]), 8), 2u);
+
+  const size_t order[] = {2, 3, 0, 1};  // slot-2 frames first, then late slot-1
+  size_t expected = 0;
+  for (size_t idx : order) {
+    FeedAudio(rx, wires[idx], ssrc, 0, FrameDirection::kReceiver);
+    ++expected;
+    ASSERT_TRUE(rx.sink->WaitForCount(expected));
+    EXPECT_EQ(rx.sink->Frame(expected - 1), plains[idx]);
+  }
+  FeedAudio(rx, wires[1], ssrc, 0, FrameDirection::kReceiver);  // replay: dropped
+  signaling.Flush();
+  // Wait until the drop was processed via a sentinel frame.
+  const auto sentinel_plain = AudioPayload(24, 99);
+  const auto sentinel = SealAudio(tx, sentinel_plain, ssrc, 100 + 960 * 4);
+  FeedAudio(rx, sentinel, ssrc, 0, FrameDirection::kReceiver);
+  ASSERT_TRUE(rx.sink->WaitForCount(expected + 1));
+  EXPECT_EQ(rx.sink->Count(), expected + 1);
+
+  // Window GC through the real provider: retiring slot 1 keeps the window
+  // (slot 2 still authenticates), retiring slot 2 as well collects it.
+  auto handler = rx_provider->GetKey("lee");
+  ASSERT_EQ(handler->ReplayWindowCountForTesting(), 1u);
+  rx_provider->SetKey("lee", 1, std::vector<uint8_t>(32, 0));
+  EXPECT_EQ(handler->ReplayWindowCountForTesting(), 1u);
+  rx_provider->SetKey("lee", 2, std::vector<uint8_t>(32, 0));
+  EXPECT_EQ(handler->ReplayWindowCountForTesting(), 0u);
+  // Re-installing the zero key is idempotent: nothing to collect, no crash.
+  rx_provider->SetKey("lee", 2, std::vector<uint8_t>(32, 0));
+  EXPECT_EQ(handler->ReplayWindowCountForTesting(), 0u);
+}
