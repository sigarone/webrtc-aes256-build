+// One real FrameCryptorTransformer with a collecting sink and observer.
+struct Cryptor {
+  Cryptor(Thread* signaling,
+          const std::string& participant_id,
+          CryptorMediaType type,
+          scoped_refptr<KeyProvider> provider,
+          int key_index,
+          uint32_t video_ssrc = 0) {
+    transformer = scoped_refptr<FrameCryptorTransformer>(
+        new FrameCryptorTransformer(signaling, participant_id, type,
+                                    FrameCryptorTransformer::Algorithm::kAesGcm,
+                                    std::move(provider)));
+    transformer->SetEnabled(true);
+    transformer->SetKeyIndex(key_index);
+    transformer->RegisterFrameCryptorTransformerObserver(observer);
+    FrameTransformerInterface* iface = transformer.get();
+    if (type == CryptorMediaType::kAudioFrame) {
+      iface->RegisterTransformedFrameCallback(sink);
+    } else {
+      iface->RegisterTransformedFrameSinkCallback(sink, video_ssrc);
+    }
+  }
+  void Feed(std::unique_ptr<TransformableFrameInterface> frame) {
+    FrameTransformerInterface* iface = transformer.get();
+    iface->Transform(std::move(frame));
+  }
+
+  scoped_refptr<CollectingSink> sink = webrtc::make_ref_counted<CollectingSink>();
+  scoped_refptr<CollectingObserver> observer =
+      webrtc::make_ref_counted<CollectingObserver>();
+  scoped_refptr<FrameCryptorTransformer> transformer;
+};
+
+// Opus-like payload: 1 clear header byte + (n - 1) pseudo-random bytes.
+std::vector<uint8_t> AudioPayload(size_t n, uint8_t seed) {
+  std::vector<uint8_t> v(n);
+  for (size_t i = 0; i < n; ++i) {
+    v[i] = static_cast<uint8_t>(seed * 31 + i * 7 + 3);
+  }
+  v[0] = 0x78;
+  return v;
+}
+
+void FeedAudio(Cryptor& c,
+               const std::vector<uint8_t>& data,
+               uint32_t ssrc,
+               uint32_t timestamp,
+               FrameDirection direction) {
+  c.Feed(std::make_unique<TestAudioFrame>(data, ssrc, timestamp, direction));
+}
+
+// Seals one audio frame with the sender cryptor and returns the wire bytes.
+std::vector<uint8_t> SealAudio(Cryptor& tx,
+                               const std::vector<uint8_t>& plain,
+                               uint32_t ssrc,
+                               uint32_t timestamp) {
+  const size_t before = tx.sink->Count();
+  FeedAudio(tx, plain, ssrc, timestamp, FrameDirection::kSender);
+  EXPECT_TRUE(tx.sink->WaitForCount(before + 1));
+  return tx.sink->Frame(before);
+}
