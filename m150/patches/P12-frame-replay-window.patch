+std::vector<uint8_t> FromHex(const char* hex) {
+  std::vector<uint8_t> out;
+  const size_t n = std::strlen(hex);
+  for (size_t i = 0; i + 1 < n; i += 2) {
+    auto nibble = [](char c) -> uint8_t {
+      return static_cast<uint8_t>(c <= '9' ? c - '0' : c - 'a' + 10);
+    };
+    out.push_back(static_cast<uint8_t>((nibble(hex[i]) << 4) | nibble(hex[i + 1])));
+  }
+  return out;
+}
+
+CryptorMediaType KatMediaType(const KatFrame& f) {
+  return f.codec == kKatOpus ? CryptorMediaType::kAudioFrame : CryptorMediaType::kVideoFrame;
+}
+
+std::unique_ptr<TransformableFrameInterface> KatMakeFrame(
+    const KatFrame& f,
+    std::vector<uint8_t> data,
+    FrameDirection direction) {
+  if (f.codec == kKatOpus) {
+    return std::make_unique<TestAudioFrame>(std::move(data), f.ssrc, f.rtp_ts,
+                                            direction);
+  }
+  return std::make_unique<TestVideoFrame>(
+      std::move(data), f.ssrc, f.rtp_ts, direction,
+      f.codec == kKatH264 ? VideoCodecType::kVideoCodecH264
+                          : VideoCodecType::kVideoCodecVP8,
+      f.key_frame);
+}
+
+// Fresh receiver provider holding exactly `f`'s key, then open `wire`.
+bool KatOpen(Thread* signaling,
+             const KatFrame& f,
+             const std::vector<uint8_t>& wire,
+             std::vector<uint8_t>* plain) {
+  auto provider = MakeHkdfProvider(false);
+  provider->SetKey(f.participant, f.key_index, FromHex(f.key_hex));
+  Cryptor rx(signaling, f.participant, KatMediaType(f), provider, f.key_index,
+             f.ssrc);
+  rx.Feed(KatMakeFrame(f, wire, FrameDirection::kReceiver));
+  if (!rx.sink->WaitForCount(1, 10000)) {
+    return false;
+  }
+  *plain = rx.sink->Frame(0);
+  return true;
+}
+
+// Fresh sender provider with the send counter set through the test seam.
+bool KatSeal(Thread* signaling,
+             const KatFrame& f,
+             std::vector<uint8_t>* wire) {
+  auto provider = MakeHkdfProvider(false);
+  provider->SetKey(f.participant, f.key_index, FromHex(f.key_hex));
+  provider->GetKey(f.participant)->SetSendCounterForTesting(f.ssrc, f.counter);
+  Cryptor tx(signaling, f.participant, KatMediaType(f), provider, f.key_index,
+             f.ssrc);
+  tx.Feed(KatMakeFrame(f, FromHex(f.plaintext_hex), FrameDirection::kSender));
+  if (!tx.sink->WaitForCount(1, 10000)) {
+    return false;
+  }
+  *wire = tx.sink->Frame(0);
+  return true;
+}
+
+// Independent RBSP unescape of header(U) || tail, to check wireUnescaped.
+std::vector<uint8_t> KatUnescape(const std::vector<uint8_t>& wire, size_t header) {
+  std::vector<uint8_t> out(wire.begin(), wire.begin() + header);
+  for (size_t i = header; i < wire.size();) {
+    if (i + 2 < wire.size() && wire[i] == 0 && wire[i + 1] == 0 &&
+        wire[i + 2] == 3) {
+      out.push_back(0);
+      out.push_back(0);
+      i += 3;
+    } else {
+      out.push_back(wire[i++]);
+    }
+  }
+  return out;
+}
+
+// Delivers `f` to a fresh receiver cryptor of the SHARED `provider` (the
+// replay window lives in the participant's handler, so every cryptor of the
+// participant sees the same window) and classifies what happened. A fresh
+// cryptor starts with no cached failure state, so every verdict is observable:
+//   ok             -> the sink gets the frame
+//   decrypt_failed -> observer kDecryptionFailed
+//   missing_key    -> observer kMissingKey
+//   duplicate / too_old / reflected / cap -> the matching handler counter moves
+//                     and NOTHING else happens (no state, no output).
+std::string KatClassify(ReplayTestThread& signaling,
+                        scoped_refptr<DefaultKeyProviderImpl> provider,
+                        const std::string& participant,
+                        const KatFrame& f,
+                        const std::vector<uint8_t>& wire,
+                        std::vector<uint8_t>* plain,
+                        std::string* problem) {
+  auto handler = provider->GetKey(participant);
+  ReplayCounters before;
+  if (handler != nullptr) {
+    before = handler->GetReplayCounters();
+  }
+  Cryptor rx(signaling.get(), participant, KatMediaType(f), provider, 0, f.ssrc);
+  rx.Feed(KatMakeFrame(f, wire, FrameDirection::kReceiver));
+  std::string verdict = "timeout";
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(10);
+  while (std::chrono::steady_clock::now() < deadline) {
+    if (rx.sink->Count() > 0) {
+      verdict = "ok";
+      break;
+    }
+    if (rx.observer->CountOf(FrameCryptionState::kDecryptionFailed) > 0) {
+      verdict = "decrypt_failed";
+      break;
+    }
+    if (rx.observer->CountOf(FrameCryptionState::kMissingKey) > 0) {
+      verdict = "missing_key";
+      break;
+    }
+    if (handler != nullptr) {
+      const ReplayCounters c = handler->GetReplayCounters();
+      if (c.dup != before.dup) {
+        verdict = "duplicate";
+        break;
+      }
+      if (c.old != before.old) {
+        verdict = "too_old";
+        break;
+      }
+      if (c.refl != before.refl) {
+        verdict = "reflected";
+        break;
+      }
+      if (c.cap != before.cap) {
+        verdict = "cap";
+        break;
+      }
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(2));
+  }
+  signaling.Flush();
+  // Side effects must match the verdict exactly.
+  const size_t failed = rx.observer->CountOf(FrameCryptionState::kDecryptionFailed);
+  const size_t missing = rx.observer->CountOf(FrameCryptionState::kMissingKey);
+  if (verdict == "ok") {
+    if (failed != 0 || missing != 0) *problem = "ok frame produced a failure state";
+    if (rx.sink->Count() != 1) *problem = "ok frame produced no single output";
+    *plain = rx.sink->Frame(0);
+  } else {
+    if (rx.sink->Count() != 0) *problem = verdict + " frame produced output";
+    if (verdict != "decrypt_failed" && failed != 0) *problem = verdict + " produced kDecryptionFailed";
+    if (verdict != "missing_key" && missing != 0) *problem = verdict + " produced kMissingKey";
+  }
+  if (handler != nullptr) {
+    const ReplayCounters c = handler->GetReplayCounters();
+    const uint64_t moved = (c.dup - before.dup) + (c.old - before.old) +
+                           (c.refl - before.refl) + (c.cap - before.cap);
+    const bool replay_verdict = verdict == "duplicate" || verdict == "too_old" ||
+                                verdict == "reflected" || verdict == "cap";
+    if (moved != (replay_verdict ? 1u : 0u)) *problem = "unexpected replay counter movement";
+  }
+  return verdict;
+}
+
+const KatFrame* KatFind(const KatFrame* frames, size_t n, const std::string& id) {
+  for (size_t i = 0; i < n; ++i) {
+    if (id == frames[i].id) return &frames[i];
+  }
+  return nullptr;
+}
