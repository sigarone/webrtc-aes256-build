+// ---- Q-Audion P12: sender counter and receiver anti-replay window ---------
+
+std::optional<uint32_t> ParticipantKeyHandler::NextSendCounter(uint32_t ssrc) {
+  webrtc::MutexLock lock(&mutex_);
+  // First frame of a ssrc: counter 0. The map entry doubles as the "local
+  // send ssrc" set that feeds the reflection guard.
+  auto it = send_next_.try_emplace(ssrc, 0).first;
+  if (it->second > 0xFFFFFFFFull) {
+    send_exhausted_.fetch_add(1, std::memory_order_relaxed);
+    return std::nullopt;
+  }
+  const uint32_t counter = static_cast<uint32_t>(it->second);
+  it->second += 1;
+  return counter;
+}
+
+void ParticipantKeyHandler::SetSendCounterForTesting(uint32_t ssrc,
+                                                     uint32_t next) {
+  webrtc::MutexLock lock(&mutex_);
+  send_next_[ssrc] = next;
+}
+
+size_t ParticipantKeyHandler::ReplayWindowCountForTesting() {
+  webrtc::MutexLock lock(&mutex_);
+  return windows_.size();
+}
+
+ReplayCounters ParticipantKeyHandler::GetReplayCounters() const {
+  ReplayCounters c;
+  c.dup = replay_dup_.load(std::memory_order_relaxed);
+  c.old = replay_old_.load(std::memory_order_relaxed);
+  c.refl = replay_refl_.load(std::memory_order_relaxed);
+  c.cap = replay_cap_.load(std::memory_order_relaxed);
+  c.exhausted = send_exhausted_.load(std::memory_order_relaxed);
+  return c;
+}
+
+bool ParticipantKeyHandler::SameKeyMaterial(
+    const webrtc::scoped_refptr<KeySet>& current,
+    const std::vector<uint8_t>& material) {
+  if (current == nullptr || current->material.size() != material.size()) {
+    return false;
+  }
+  // Constant time: key material must not leak through compare timing.
+  return CRYPTO_memcmp(current->material.data(), material.data(),
+                       material.size()) == 0;
+}
+
+void ParticipantKeyHandler::OnSlotMaterialChangedLocked(size_t slot) {
+  if (slot >= MAX_KEYRING_SIZE) {
+    return;
+  }
+  for (auto it = windows_.begin(); it != windows_.end();) {
+    it->second.slot_mask.reset(slot);
+    if (it->second.slot_mask.none()) {
+      it = windows_.erase(it);
+    } else {
+      ++it;
+    }
+  }
+}
+
+ReplayVerdict ParticipantKeyHandler::ReplayCheckLocked(uint32_t iv_ssrc,
+                                                       uint32_t counter,
+                                                       int key_index,
+                                                       bool commit) {
+  // Reflection guard: a frame carrying one of OUR send ssrcs is our own
+  // stream coming back (1:1 shares one handler between both directions).
+  if (send_next_.find(iv_ssrc) != send_next_.end()) {
+    return ReplayVerdict::kReflected;
+  }
+  const size_t slot =
+      (key_index >= 0 ? static_cast<size_t>(key_index)
+                      : static_cast<size_t>(current_key_index_)) %
+      crypto_key_ring_.size();
+
+  auto it = windows_.find(iv_ssrc);
+  if (it == windows_.end()) {
+    if (commit) {
+      if (windows_.size() >= kMaxReplayWindowsPerHandler) {
+        return ReplayVerdict::kCap;
+      }
+      ReplayWindow w;
+      w.top = counter;
+      w.seen.set(0);
+      w.slot_mask.set(slot);
+      windows_.emplace(iv_ssrc, w);
+    }
+    return ReplayVerdict::kOk;
+  }
+
+  ReplayWindow& w = it->second;
+  if (counter > w.top) {
+    if (commit) {
+      const uint32_t d = counter - w.top;
+      if (d >= kReplayWindowFrames) {
+        w.seen.reset();
+      } else {
+        w.seen <<= static_cast<size_t>(d);
+      }
+      w.seen.set(0);
+      w.top = counter;
+      w.slot_mask.set(slot);
+    }
+    return ReplayVerdict::kOk;
+  }
+  const uint32_t d = w.top - counter;
+  if (d >= kReplayWindowFrames) {
+    return ReplayVerdict::kTooOld;
+  }
+  if (w.seen.test(static_cast<size_t>(d))) {
+    return ReplayVerdict::kDuplicate;
+  }
+  if (commit) {
+    w.seen.set(static_cast<size_t>(d));
+    w.slot_mask.set(slot);
+  }
+  return ReplayVerdict::kOk;
+}
+
+ReplayVerdict ParticipantKeyHandler::ReplayCheck(uint32_t iv_ssrc,
+                                                 uint32_t counter,
+                                                 int key_index,
+                                                 bool commit) {
+  ReplayVerdict verdict;
+  {
+    webrtc::MutexLock lock(&mutex_);
+    verdict = ReplayCheckLocked(iv_ssrc, counter, key_index, commit);
+  }
+  switch (verdict) {
+    case ReplayVerdict::kDuplicate:
+      replay_dup_.fetch_add(1, std::memory_order_relaxed);
+      break;
+    case ReplayVerdict::kTooOld:
+      replay_old_.fetch_add(1, std::memory_order_relaxed);
+      break;
+    case ReplayVerdict::kReflected:
+      replay_refl_.fetch_add(1, std::memory_order_relaxed);
+      break;
+    case ReplayVerdict::kCap:
+      replay_cap_.fetch_add(1, std::memory_order_relaxed);
+      break;
+    case ReplayVerdict::kOk:
+      break;
+  }
+  return verdict;
+}
