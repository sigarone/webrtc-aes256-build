+TEST(FrameCryptorReplay, SharedKeyReflectionOfOwnFramesIsDropped) {
+  ReplayTestThread signaling;
+  // Shared-key mode: sender and receiver cryptors of one call bind the SAME
+  // participant id, hence the same handler (and the same key).
+  auto local = MakeHkdfProvider(true);
+  auto remote = MakeHkdfProvider(true);
+  ASSERT_TRUE(local->SetSharedKey(0, TestKey32(4)));
+  ASSERT_TRUE(remote->SetSharedKey(0, TestKey32(4)));
+  Cryptor tx(signaling.get(), "peer", CryptorMediaType::kAudioFrame, local, 0);
+  Cryptor rx(signaling.get(), "peer", CryptorMediaType::kAudioFrame, local, 0);
+  Cryptor remote_tx(signaling.get(), "peer", CryptorMediaType::kAudioFrame, remote, 0);
+
+  const uint32_t own_ssrc = 0x11111111u;
+  const uint32_t peer_ssrc = 0x22222222u;
+  const auto own_plain = AudioPayload(28, 1);
+  const auto peer_plain = AudioPayload(28, 2);
+  const auto own_wire = SealAudio(tx, own_plain, own_ssrc, 700);
+  const auto peer_wire = SealAudio(remote_tx, peer_plain, peer_ssrc, 700);
