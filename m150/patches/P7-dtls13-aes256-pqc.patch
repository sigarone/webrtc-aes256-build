--- a/api/crypto/crypto_options.cc
+++ b/api/crypto/crypto_options.cc
@@ -173,6 +173,23 @@ void CryptoOptions::EphemeralKeyExchangeCipherGroups::Update(
     });
   }
 
+  // Q-Audion (finding #9): "WebRTC-EnableDtlsPqc/Disabled/" is the emergency
+  // kill switch for the PQC hybrid group that P7's strict-build
+  // GetDefaultEphemeralKeyExchangeCipherGroups() prefers by default (no
+  // trial needed to turn it ON - see ssl_stream_adapter.cc). Below, this
+  // function only ever ADDS groups from `default_groups` into `enabled_`
+  // and keeps everything already there - so once the group is in
+  // `enabled_` (e.g. from the constructor's own call to
+  // GetDefaultEphemeralKeyExchangeCipherGroups(nullptr), made before any
+  // real FieldTrialsView existed to check the switch against), the switch
+  // had no way to take it back out again: it disabled the *default*, not
+  // the *already-enabled* value. Purge it explicitly whenever the same
+  // trial we just consulted for `default_groups` says Disabled, so the
+  // emergency PQC-off path actually removes the group either way.
+  if (field_trials && field_trials->IsDisabled("WebRTC-EnableDtlsPqc")) {
+    std::erase(enabled_, kX25519_MLKEM768);
+  }
+
   // Add those enabled by field-trials first.
   std::vector<uint16_t> current = std::move(enabled_);
   enabled_.clear();
