+      SSL_get_selected_srtp_profile(ssl_);
+  const unsigned srtp_id =
+      srtp_profile ? static_cast<unsigned>(srtp_profile->id) : 0u;
+  const uint16_t group_id = SSL_get_group_id(ssl_);
+  const int version = SSL_version(ssl_);
+  const bool is_dtls13 = version == DTLS1_3_VERSION;
