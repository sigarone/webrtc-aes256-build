+  // to under our ClientHello/ServerHello - see SetupSSLContext()'s
+  // ssl_compliance_policy_cnsa_202407 call), or either AES-256-GCM DTLS 1.2
+  // suite SetupSSLContext() allowed in via SSL_CTX_set_strict_cipher_list().
+  constexpr uint16_t kTlsAes256GcmSha384 = 0x1302;
+  constexpr uint16_t kEcdheEcdsaAes256GcmSha384 = 0xC02C;
+  constexpr uint16_t kEcdheRsaAes256GcmSha384 = 0xC030;
+  const bool cipher_ok =
+      cipher_id == kTlsAes256GcmSha384 ||
+      (!is_dtls13 && (cipher_id == kEcdheEcdsaAes256GcmSha384 ||
+                      cipher_id == kEcdheRsaAes256GcmSha384));
