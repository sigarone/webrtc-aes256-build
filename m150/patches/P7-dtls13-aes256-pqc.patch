+      srtp_ciphers_.empty() || srtp_id == SRTP_AEAD_AES_256_GCM;
+  const bool pqc_ok = !qaudion::RequireDtlsPqc() ||
+                      group_id == SSL_GROUP_X25519_MLKEM768;
+  const bool ok = (level < 1 || srtp_ok) && (level < 2 || cipher_ok) &&
+                  (level < 3 || is_dtls13) && pqc_ok;
