+bool OpenSSLStreamAdapter::QaudionHandshakeMeetsPolicy() {
+  const int level = qaudion::TransportLevel();  // strict builds: always 3
+  const SSL_CIPHER* cipher = SSL_get_current_cipher(ssl_);
