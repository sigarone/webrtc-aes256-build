+  // Ids only, never key material: safe to always log (G3 gate greps the
+  // binary for exactly this line's prefix).
+  RTC_LOG(LS_WARNING) << absl::StrFormat(
+      "Q-AUDION dtls v=%04x cipher=%04x srtp=%04x group=%04x level=%d "
+      "pqc_req=%d ok=%d",
+      static_cast<unsigned>(version), cipher_id, srtp_id, group_id, level,
+      qaudion::RequireDtlsPqc() ? 1 : 0, ok ? 1 : 0);
+  return ok;
+}
