+namespace {
+// Q-Audion (M150 hardening, P4b / finding #15): applies the current runtime
+// decoder-complexity override - or kQaudionDefaultDecoderComplexity when the
+// app has not set one - to a single-stream decoder. `complexity` is always
+// already range-checked by webrtc::qaudion::SetOpusDecoderComplexity() (or
+// is the compile-time default), so this can never hand libopus a value that
+// makes it fail; nothing here is reachable from unvalidated input.
+//
+// Called from decoder creation, decoder reset, and - the case finding #15
+// actually asks for - right before every opus_decode() in DecodeNative()
+// below, so a mid-call change from the app takes effect on the very next
+// frame. All three call sites run on the thread that owns `state` (WebRTC's
+// NetEQ decode call path owns a given OpusDecInst exclusively), so this is
+// never invoked concurrently with another opus_decoder_ctl() on the same
+// instance.
+void ApplyQaudionDecoderComplexity(OpusDecInst* state) {
+  if (!state->decoder) {
+    return;
+  }
+  int complexity = webrtc::qaudion::OpusDecoderComplexity();
+  if (complexity < 0) {
+    complexity = webrtc::qaudion::kQaudionDefaultDecoderComplexity;
+  }
+  opus_decoder_ctl(state->decoder, OPUS_SET_COMPLEXITY(complexity));
+}
