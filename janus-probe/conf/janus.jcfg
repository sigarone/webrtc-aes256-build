general: {
	configs_folder = "@JROOT@/etc/janus"
	plugins_folder = "@JROOT@/lib/janus/plugins"
	transports_folder = "@JROOT@/lib/janus/transports"
	events_folder = "@JROOT@/lib/janus/events"
	loggers_folder = "@JROOT@/lib/janus/loggers"
	debug_level = 5
	debug_timestamps = true
	debug_colors = false
}
certificates: {
	# no cert/key given: janus autogenerates an ECDSA P-256 self-signed one
}
media: {
	dtls_mtu = 1200
	dtls_timeout = 500
}
nat: {
	# same-host test: nothing to ignore except container/virtual interfaces
	ice_ignore_list = "vmnet,docker,veth,br-"
}
