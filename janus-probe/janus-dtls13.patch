@@ -492,6 +529,12 @@ gint janus_dtls_srtp_init(const char *server_pem, const char *server_key, const
 		JANUS_LOG(LOG_FATAL, "Error setting cipher list (%s)\n", ERR_reason_error_string(ERR_get_error()));
