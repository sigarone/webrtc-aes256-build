+/* DTLS 1.3 / ML-KEM / AES-256-GCM-only transport policy (probe patch).
+ * Only BoringSSL implements DTLS 1.3 and the X25519MLKEM768 hybrid group */
+#ifndef HAVE_BORINGSSL
+#error "The DTLS 1.3 policy patch requires BoringSSL (--enable-boringssl)"
+#endif
+#ifndef DTLS1_3_VERSION
+#error "This BoringSSL does not provide DTLS 1.3"
+#endif
+#define JANUS_DTLS_TLS_AES_256_GCM_SHA384	0x1302
+static const uint16_t janus_dtls_groups[] = { SSL_GROUP_X25519_MLKEM768, SSL_GROUP_X25519 };
+
+/* Fail-closed check of what was actually negotiated: ids only, no key material */
+static gboolean janus_dtls_policy_ok(janus_dtls_srtp *dtls, guint64 handle_id) {
+	const SSL_CIPHER *cipher = SSL_get_current_cipher(dtls->ssl);
+	const SRTP_PROTECTION_PROFILE *profile = SSL_get_selected_srtp_profile(dtls->ssl);
+	unsigned int version = (unsigned int)SSL_version(dtls->ssl);
+	unsigned int cipher_id = cipher ? SSL_CIPHER_get_protocol_id(cipher) : 0;
+	unsigned int srtp_id = profile ? (unsigned int)profile->id : 0;
+	unsigned int group_id = SSL_get_group_id(dtls->ssl);
+	gboolean ok = (version == DTLS1_3_VERSION &&
+		cipher_id == JANUS_DTLS_TLS_AES_256_GCM_SHA384 &&
+		srtp_id == SRTP_AEAD_AES_256_GCM &&
+		group_id == SSL_GROUP_X25519_MLKEM768);
+	janus_ice_peerconnection *pc = (janus_ice_peerconnection *)dtls->pc;
+	JANUS_LOG(LOG_INFO, "[%"SCNu64"] DTLS-POLICY version=0x%04x cipher=0x%04x srtp=0x%04x group=0x%04x role=%s ok=%d"
+		" dtls_in=%"SCNu64"pkts/%"SCNu64"B dtls_out=%"SCNu64"pkts/%"SCNu64"B\n",
+		handle_id, version, cipher_id, srtp_id, group_id,
+		dtls->dtls_role == JANUS_DTLS_ROLE_CLIENT ? "client" : "server", ok ? 1 : 0,
+		pc ? (guint64)pc->dtls_in_stats.info[0].packets : 0, pc ? (guint64)pc->dtls_in_stats.info[0].bytes : 0,
+		pc ? (guint64)pc->dtls_out_stats.info[0].packets : 0, pc ? (guint64)pc->dtls_out_stats.info[0].bytes : 0);
+	return ok;
+}
