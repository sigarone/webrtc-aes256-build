# Smoke-test Janus core configuration TEMPLATE. scripts/smoke.sh renders it into a
# private directory (never into the uploaded artifacts) and fills the keys written
# between two at-signs in the settings below:
#   JROOT         install root of the smoke Janus build
#   CONFDIR       the rendered configuration directory
#   TOKEN_SECRET  random HMAC secret of this run (token_auth)
#   DEBUG_LEVEL   5 = verbose enough for the "DTLS-POLICY" lines
#   ICE_LITE      true/false (SMOKE_ICE_LITE=0 switches ICE lite off)
# It mirrors the production qjanus configuration; the only differences are the
# debug level, an autogenerated DTLS certificate and IPv6 off (CI runners have none).
general: {
	configs_folder = "@CONFDIR@"
	plugins_folder = "@JROOT@/lib/janus/plugins"
	transports_folder = "@JROOT@/lib/janus/transports"
	events_folder = "@JROOT@/lib/janus/events"
	loggers_folder = "@JROOT@/lib/janus/loggers"

	debug_level = @DEBUG_LEVEL@
	debug_timestamps = true
	debug_colors = false
	server_name = "qjanus"
	hide_dependencies = true
	exit_on_dl_error = true

	# HMAC-SHA256 signed tokens ("<expiry>,janus,janus.plugin.videoroom:<base64 signature>");
	# there is no api_secret and the Admin API is off in every transport.
	token_auth = true
	token_auth_secret = "@TOKEN_SECRET@"
	token_auth_hash = "sha256"

	session_timeout = 60
	reclaim_session_timeout = 20
}

# No certificate given: Janus generates a fresh ECDSA P-256 self-signed one at start.
certificates: {
}

media: {
	ipv6 = false
	min_nack_queue = 500
	rtp_port_range = "20000-20999"
	dtls_mtu = 1200
	dtls_timeout = 500
	twcc_period = 200
	slowlink_threshold = 4
	no_media_timer = 1
}

nat: {
	ice_lite = @ICE_LITE@
	ice_tcp = false
	# same-host test: only container/virtual interfaces are to be ignored
	ice_ignore_list = "vmnet,docker,veth,br-"
}

# No other plugins, transports, event handlers or loggers exist in this build.
plugins: {
}
transports: {
}
loggers: {
}
events: {
}
