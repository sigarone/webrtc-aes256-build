[Unit]
Description=qjanus - Janus VideoRoom SFU (DTLS 1.3 + X25519MLKEM768 + AES-256-GCM only)
Documentation=https://github.com/sigarone/webrtc-aes256-build/tree/main/qjanus
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
User=qjanus

# root-only secrets (token secret, admin key) and per-node settings; the DTLS private key
# reaches the service as a systemd credential (/run/credentials/qjanus.service/dtls.key)
EnvironmentFile=/etc/qjanus/qjanus.env
LoadCredential=dtls.key:/etc/qjanus/dtls.key
Environment=QJANUS_DTLS_CERT=/etc/qjanus/dtls.crt
Environment=QJANUS_DTLS_KEY=%d/dtls.key
RuntimeDirectory=qjanus
RuntimeDirectoryMode=0700

ExecStartPre=/opt/qjanus/current/libexec/qjanus-render-config
ExecStart=/opt/qjanus/current/bin/janus -F /run/qjanus/etc
# fail closed: no half-working node (Janus keeps running without a transport it could not bind)
ExecStartPost=/opt/qjanus/current/libexec/qjanus-wait-ready
TimeoutStartSec=60
Restart=on-failure
RestartSec=1
TimeoutStopSec=10
SyslogIdentifier=qjanus

# sandbox
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallFilter=@system-service
InaccessiblePaths=-/opt/bcrypto -/root -/etc/bcrypto -/var/lib/bcrypto
UMask=0077

# limits: the SFU must never starve the application server on the same host
MemoryMax=2G
CPUQuota=200%
CPUWeight=50
TasksMax=4096
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
