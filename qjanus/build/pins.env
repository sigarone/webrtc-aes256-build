# Source pins for the qjanus build. Sourced by build-deps.sh, build-janus.sh and
# package.sh; every entry is a full commit sha and the scripts refuse to build
# anything else. Changing a pin is a deliberate, reviewed commit.

# Janus gateway (upstream tag v1.4.2)
JANUS_TAG=v1.4.2
JANUS_SHA=0a24110ae55a172c4293749b763dbb66a138f9ec

# BoringSSL: the exact commit the hardened WebRTC M150 builds pin (DTLS 1.3, X25519MLKEM768)
BORINGSSL_SHA=f91f1447397c6719f9774dfb8e67329378e1f3d3

# libsrtp 2.x with the BoringSSL crypto backend (AES-GCM), statically linked
LIBSRTP_TAG=v2.8.1
LIBSRTP_SHA=6ff02afa8d2dc3f2e8896af391d137c1c66ff6fa

# libnice (GnuTLS crypto backend: never an OpenSSL in the process)
LIBNICE_TAG=0.1.24
LIBNICE_SHA=af62014d520ac09c8fe1974bda1b253114c68843

# libwebsockets, built WITHOUT any TLS library (the WebSocket server is plain and sits behind Caddy)
LWS_TAG=v4.3.10
LWS_SHA=2288cf200bc1c28680765bd4f07e437356106c2d
