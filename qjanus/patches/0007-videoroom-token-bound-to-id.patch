 }
 
+/* qjanus: the join token of a publisher is bound to its participant id (the per-call pseudonym).
+ * The token has the form "<id>:<32 lowercase hex>", its prefix must be the "id" of the join request
+ * and the id must be present: the token handed to one member cannot be used to join under the
+ * pseudonym of another member. (The token must also be in the room's "allowed" list, as before.)
+ * Only string ids exist in qjanus, a numeric id is refused. */
+static gboolean janus_videoroom_join_token_bound(json_t *root) {
+	const char *id = json_string_value(json_object_get(root, "id"));
+	const char *token = json_string_value(json_object_get(root, "token"));
+	if(id == NULL || id[0] == '\0' || token == NULL)
+		return FALSE;
+	size_t idlen = strlen(id);
+	if(strlen(token) != idlen + 1 + 32 || strncmp(token, id, idlen) != 0 || token[idlen] != ':')
+		return FALSE;
+	const char *hex = token + idlen + 1;
+	size_t i = 0;
+	for(i = 0; i < 32; i++) {
+		if(!((hex[i] >= '0' && hex[i] <= '9') || (hex[i] >= 'a' && hex[i] <= 'f')))
+			return FALSE;
+	}
+	return TRUE;
+}
+
 /* Thread to handle incoming messages */
 static void *janus_videoroom_handler(void *data) {
 	JANUS_LOG(LOG_VERB, "Joining VideoRoom handler thread\n");
@@ -9700,6 +9722,16 @@ static void *janus_videoroom_handler(void *data) {
 			const char *ptype_text = json_string_value(ptype);
 			if(!strcasecmp(ptype_text, "publisher")) {
 				JANUS_LOG(LOG_VERB, "Configuring new publisher\n");
+				/* qjanus: refuse, before anything else, a join whose token is not bound to its id */
+				if(!janus_videoroom_join_token_bound(root)) {
+					janus_mutex_unlock(&videoroom->mutex);
+					janus_mutex_unlock(&sessions_mutex);
+					janus_refcount_decrease(&videoroom->ref);
+					JANUS_LOG(LOG_ERR, "Unauthorized (the join token is not bound to the participant id)\n");
+					error_code = JANUS_VIDEOROOM_ERROR_UNAUTHORIZED;
+					g_snprintf(error_cause, 512, "Unauthorized (the join token is not bound to the participant id)");
+					goto error;
+				}
 				JANUS_VALIDATE_JSON_OBJECT(root, publisher_parameters,
 					error_code, error_cause, TRUE,
 					JANUS_VIDEOROOM_ERROR_MISSING_ELEMENT, JANUS_VIDEOROOM_ERROR_INVALID_ELEMENT);
